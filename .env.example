# Copy this file to .env.local and fill it in. Never commit .env.local.
# Without these, the site still runs: the contact form tells visitors to email instead.
# Setup guide: docs/CONTACT_FORM.md

# Secret key from https://resend.com/api-keys (server only, never shown to the browser).
RESEND_API_KEY=

# Where contact messages are sent.
NOTIFY_EMAIL=

# Optional. Only set this after verifying your own domain in Resend,
# for example: Portfolio <hello@yakobgetu.com>
NOTIFY_FROM=

# Likes and comments on posts (see docs/POSTS.md). Vercel adds these when the Upstash database
# is connected; locally, `vercel env pull .env.local` fills them in.
KV_REST_API_URL=
KV_REST_API_TOKEN=
